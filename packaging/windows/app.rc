// Qt's registerWindowClass does LoadImage(hInst, L"IDI_ICON1", ...), a *string*
// lookup, so this must stay a named resource. Give it a numeric id and the
// window class gets IDI_APPLICATION instead: right icon in Explorer, generic
// one in the taskbar and Alt-Tab.
IDI_ICON1 ICON "app.ico"

// FILEOS 0x40004 = VOS_NT_WINDOWS32, FILETYPE 0x1 = VFT_APP; spelled numerically
// so the script needs no Windows SDK headers to preprocess.
1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "David Ventura"
            VALUE "FileDescription", "Offline Translator"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "offline-translator-linux"
            VALUE "LegalCopyright", "Copyright (C) David Ventura"
            VALUE "OriginalFilename", "offline-translator-linux.exe"
            VALUE "ProductName", "Offline Translator"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
